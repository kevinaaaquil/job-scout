# Auth: users are stored in MongoDB "users" collection with hashed passwords.
# Initial user is seeded from config.yaml (user_email / user_password).
# Vertex AI Search (set provider to "vertex" in config to use)
# Local dev: point to the JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Dokku/container: base64-encode the JSON instead (takes priority if GOOGLE_APPLICATION_CREDENTIALS is unset)
GOOGLE_CREDENTIALS_B64=eyJ0eXBlIjoic2VydmljZS...
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_ENGINE_ID=your-search-engine-id
VERTEX_DATASTORE_ID=your-datastore-id

